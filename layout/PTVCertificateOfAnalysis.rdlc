                                <TextRun>
                                  <Value>="Target: " &amp; Format(First(Fields!PTV_DeltaE_Target.Value, "DataSet_Result"), "0.00") &amp; "   Max: " &amp; Format(First(Fields!PTV_DeltaE_Max.Value, "DataSet_Result"), "0.00")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>

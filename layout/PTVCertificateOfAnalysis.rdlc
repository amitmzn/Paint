                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValLot">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!QltyInspection_Source_Lot_No_.Value, "DataSet_Result")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8.5pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#0B5394</Color>

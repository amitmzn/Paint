                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Row 3: Shade Code & Specific Gravity -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblShade">

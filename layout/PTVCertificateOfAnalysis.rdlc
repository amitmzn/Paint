                <!-- Row 6: Overall Inspection Disposition -->
                <TablixRow>
                  <Height>0.24in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblStatus">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Quality Disposition:</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#F3F6F8</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>3pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValStatus">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!QltyInspection_Result_Code.Value, "DataSet_Result") &amp; " - " &amp; First(Fields!QltyInspection_Result_Description.Value, "DataSet_Result")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8.5pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIF(First(Fields!QltyInspection_Result_Code.Value, "DataSet_Result") = "PASS", "#2E7D32", "#C62828")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>3pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblAnalyst">

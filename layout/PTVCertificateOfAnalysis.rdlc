                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValSolids">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(First(Fields!PTV_Solids_By_Weight.Value, "DataSet_Result"), "0.00") &amp; " %"</Value>

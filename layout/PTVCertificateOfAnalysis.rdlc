                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#F3F6F8</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValLab">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="L*: " &amp; Format(First(Fields!PTV_Lab_L.Value, "DataSet_Result"), "0.00") &amp; "  a*: " &amp; Format(First(Fields!PTV_Lab_a.Value, "DataSet_Result"), "0.00") &amp; "  b*: " &amp; Format(First(Fields!PTV_Lab_b.Value, "DataSet_Result"), "0.00")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>

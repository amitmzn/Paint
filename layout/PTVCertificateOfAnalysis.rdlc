<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>3c1d4a2e-7b6f-4c2a-9e11-paintvertical</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Title & Company Header -->
          <Textbox Name="DocTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIF(First(Fields!CompanyInformation_Row1.Value, "DataSet_Result") &lt;&gt; "", First(Fields!CompanyInformation_Row1.Value, "DataSet_Result") &amp; vbCrLf, "") &amp; "CERTIFICATE OF ANALYSIS"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>13pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#294957</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.38in</Height>
            <Width>7.5in</Width>
            <Style>
              <Border>
                <Color>#294957</Color>
                <Style>Solid</Style>
                <Width>1pt</Width>
              </Border>
              <BackgroundColor>#EAEFF2</BackgroundColor>
              <PaddingTop>4pt</PaddingTop>
              <PaddingBottom>3pt</PaddingBottom>
            </Style>
          </Textbox>
          <!-- Inspection & Product Master Paint Attributes Table -->
          <Tablix Name="TablixCoaHeader">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>1.4in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.35in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>1.4in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2.35in</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Row 1: Certificate No & Inspection Date -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblCertNo">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Certificate / Insp. No:</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#F3F6F8</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValCertNo">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!QltyInspection_No.Value, "DataSet_Result") &amp; IIF(First(Fields!QltyInspection_ReinspectionNo.Value, "DataSet_Result") &gt; 0, " (Re-insp #" &amp; CStr(First(Fields!QltyInspection_ReinspectionNo.Value, "DataSet_Result")) &amp; ")", "")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8.5pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#0B5394</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblDate">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Date of Analysis:</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#F3F6F8</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValDate">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(First(Fields!QltyInspection_Finished_Date.Value, "DataSet_Result"), "dd-MMM-yyyy")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Row 2: Item Description & Lot No -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LblItem">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Item / Product:</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#D0D7DE</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#F3F6F8</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
